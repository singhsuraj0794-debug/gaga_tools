# ═══════════════════════════════════════════════════════════════
# REQUIRED — Monitoring won't run without these
# ═══════════════════════════════════════════════════════════════

# Supabase (storage)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxx

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Twilio — OTP retrieval for login flow
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Monitoring phone number registered on gajab.com (with country code, e.g. +9198XXXXXXXX)
MONITOR_PHONE=+9198XXXXXXXX

# ═══════════════════════════════════════════════════════════════
# RECOMMENDED — Enables additional checks
# ═══════════════════════════════════════════════════════════════

# PageSpeed Insights API key (for field data comparison, once daily)
PAGESPEED_API_KEY=your_api_key_here

# ═══════════════════════════════════════════════════════════════
# OPTIONAL — Override defaults
# ═══════════════════════════════════════════════════════════════

# Lighthouse CLI path (default: lighthouse)
# LIGHTHOUSE_CLI=lighthouse

# Page URLs to monitor
# MONITOR_URL_HOME=https://gajab.com/
# MONITOR_URL_CATEGORY=https://gajab.com/product-list/all
# MONITOR_URL_PRODUCT_DETAIL=https://gajab.com/product-detail/example/123

# Thresholds
# THRESHOLD_PERFORMANCE_SCORE=0.5
# THRESHOLD_LCP_MS=2500
# THRESHOLD_CLS=0.1
# THRESHOLD_TBT_MS=300
# THRESHOLD_SI_MS=4000

# Time budgets (seconds)
# BUDGET_HOME_PAGE_LOAD=5
# BUDGET_CATEGORY_PAGE_LOAD=5
# BUDGET_PRODUCT_DETAIL_LOAD=5
# BUDGET_LOGIN_SUBMIT=3
# BUDGET_OTP_RECEIVE=30
# BUDGET_BARGAIN_FLOW=20
# BUDGET_ADD_TO_CART=5
# BUDGET_CHECKOUT_NAV=10

# OTP polling
# MONITOR_OTP_TIMEOUT=30
# MONITOR_OTP_POLL_INTERVAL=3

# Page/network timeouts
# MONITOR_PAGE_TIMEOUT=30000
# MONITOR_NAV_TIMEOUT=30000
