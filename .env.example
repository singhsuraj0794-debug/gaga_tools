# ═══════════════════════════════════════════════════════════════
# REQUIRED — App won't start without these
# ═══════════════════════════════════════════════════════════════
PORT=8080

# Supabase (database)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxx

# Gajab.com gateway API
GATEWAY_KEY=your_gateway_key_here

# ═══════════════════════════════════════════════════════════════
# RECOMMENDED — Features will degrade without these
# ═══════════════════════════════════════════════════════════════

# YouTube Data API v3 (for video search)
GOOGLE_API_KEY=your_google_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# Google Custom Search (for TikTok fallback + reverse image search)
GOOGLE_CSE_ID=your_cse_id

# RapidAPI — used for TikTok, Facebook, Flipkart APIs
RAPIDAPI_KEY=your_rapidapi_key

# ═══════════════════════════════════════════════════════════════
# OPTIONAL — Scraper proxies & services
# ═══════════════════════════════════════════════════════════════

# HTTP/HTTPS proxy for scrapers (Indian residential proxy recommended)
SCRAPER_PROXY=

# External scraping services (ScraperAPI, ScrapingFish, etc.)
SCRAPING_SERVICE_URL=

# Scrape.do token (for price mapper Amazon searches)
SCRAPE_DO_TOKEN=

# ScraperAPI key
SCRAPER_API_KEY=

# Scrappley API key (Meesho)
SCRAPPLEY_API_KEY=

# ═══════════════════════════════════════════════════════════════
# OPTIONAL — Runtime tuning (defaults work fine)
# ═══════════════════════════════════════════════════════════════
YT_DLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
PYTHON_BIN=python3

SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=6.0
SCRAPER_MAX_RETRIES=2
SCRAPER_HEADLESS=true
SCRAPER_PAGE_TIMEOUT=30000
SCRAPER_NAV_TIMEOUT=30000

# Google Sheets integration
GOOGLE_SHEET_CREDENTIALS=credentials.json

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
